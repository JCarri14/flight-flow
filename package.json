{
  "name": "flightflow-poc",
  "private": true,
  "version": "0.9.6",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "start": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "npm run test:core",
    "test:core": "tsc -p tsconfig.core.json && node --test tests/core.test.mjs",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.0",
    "lucide-react": "^0.468.0",
    "motion": "^12.0.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "typescript": "~5.9.3",
    "vite": "^7.1.0"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
